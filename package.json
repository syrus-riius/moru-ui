{
  "name": "moru-ui",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run mobile:check && npm run mobile:starter:check && npm run web:starter:check && npm run registry:check && npm run project:starter:check && tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && node --test scripts/build-native-starter.test.mjs scripts/build-registry.test.mjs scripts/build-project-starter.test.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "mobile:build": "node scripts/build-native-preview.mjs",
    "mobile:check": "node scripts/build-native-preview.mjs --check",
    "web:starter:build": "node scripts/build-web-starter.mjs",
    "web:starter:check": "node scripts/build-web-starter.mjs --check",
    "mobile:starter:build": "node scripts/build-native-starter.mjs",
    "mobile:starter:check": "node scripts/build-native-starter.mjs --check",
    "public:prepare": "node scripts/prepare-public-repo.mjs",
    "registry:build": "node scripts/build-registry.mjs",
    "registry:check": "node scripts/build-registry.mjs --check",
    "registry:smoke": "node scripts/test-registry-install.mjs",
    "project:starter:build": "node scripts/build-project-starter.mjs",
    "project:starter:check": "node scripts/build-project-starter.mjs --check"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@tanstack/react-table": "9.3.1",
    "embla-carousel-react": "8.6.0",
    "lucide-react": "1.60.0",
    "pretendard": "1.3.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.14.8",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@babel/parser": "7.29.12",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "postcss": "8.5.31",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "homepage": "https://moru-ui-lab.riius.chatgpt.site/",
  "repository": {
    "type": "git",
    "url": "https://github.com/syrus-riius/moru-ui.git"
  },
  "bugs": {
    "url": "https://github.com/syrus-riius/moru-ui/issues"
  }
}
