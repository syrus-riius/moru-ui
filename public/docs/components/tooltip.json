      "required": true
    },
    {
      "owner": "TooltipProps",
      "name": "children",
      "type": "ReactNode",
      "required": true
    },
    {
      "owner": "TooltipProps",
      "name": "side",
      "type": "ComponentPropsWithoutRef<typeof BaseTooltip.Positioner>['side']",
      "required": false,
      "defaultValue": "'top'"
    },
    {
      "owner": "TooltipProps",
      "name": "align",
      "type": "ComponentPropsWithoutRef<typeof BaseTooltip.Positioner>['align']",
      "required": false,
      "defaultValue": "'center'"
    },
    {
