{
  "name": "moru-ui",
  "version": "0.5.0-beta.3",
  "description": "React UI components built for thoughtful human experiences.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./blocks": {
      "types": "./dist/blocks.d.ts",
      "import": "./dist/blocks.js",
      "default": "./dist/blocks.js"
    },
    "./dashboard": {
      "types": "./dist/dashboard.d.ts",
      "import": "./dist/dashboard.js",
      "default": "./dist/dashboard.js"
    },
    "./chart": {
      "types": "./dist/chart.d.ts",
      "import": "./dist/chart.js",
      "default": "./dist/chart.js"
    },
    "./data-table": {
      "types": "./dist/data-table.d.ts",
      "import": "./dist/data-table.js",
      "default": "./dist/data-table.js"
    },
    "./carousel": {
      "types": "./dist/carousel.d.ts",
      "import": "./dist/carousel.js",
      "default": "./dist/carousel.js"
    },
    "./resizable": {
      "types": "./dist/resizable.d.ts",
      "import": "./dist/resizable.js",
      "default": "./dist/resizable.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "@tanstack/react-table": "^9.3.1",
    "embla-carousel-react": "^8.6.0",
    "react-resizable-panels": "^4.14.8"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "lucide-react": "1.60.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/syrus-riius/moru-ui.git",
    "directory": "packages/moru-react"
  },
  "peerDependenciesMeta": {
    "recharts": {
      "optional": true
    },
    "@tanstack/react-table": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    }
  },
  "homepage": "https://moru-ui-lab.riius.chatgpt.site/",
  "bugs": {
    "url": "https://github.com/syrus-riius/moru-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "components",
    "design-system",
    "accessible",
    "typescript"
  ]
}
