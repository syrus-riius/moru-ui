{
  "schemaVersion": 1,
  "id": "combobox",
  "title": "Combobox",
  "description": "검색해서 고르는 목록",
  "example": "import { useState } from 'react'\nimport { Field } from 'moru-ui'\nimport { Combobox } from 'moru-ui'\n\nexport function AssigneePicker() {\n  const [assignee, setAssignee] = useState<string | null>(null)\n  return (\n    <Field label=\"Assignee\">\n      <Combobox\n        name=\"assignee\"\n        placeholder=\"Search people\"\n        value={assignee}\n        onValueChange={setAssignee}\n        items={[\n          { value: 'sara', label: 'Sara Kim', description: 'Design' },\n          { value: 'alex', label: 'Alex Lee', description: 'Engineering' },\n        ]}\n      />\n    </Field>\n  )\n}",
  "installCommand": "npm install moru-ui",
  "sourceUrl": "https://github.com/syrus-riius/moru-ui/blob/main/src/components/ui/combobox.tsx",
  "api": "interface ComboboxItem {\n  value: string\n  label: string\n  description?: string\n  disabled?: boolean\n}\n\ninterface ComboboxProps {\n  items: ComboboxItem[]\n  value?: string | null\n  defaultValue?: string | null\n  onValueChange?: (value: string | null) => void\n  placeholder?: string\n  'aria-label'?: string\n  'aria-labelledby'?: string\n  'aria-describedby'?: string\n  'aria-invalid'?: AriaAttributes['aria-invalid']\n  disabled?: boolean\n  loading?: boolean\n  readOnly?: boolean\n  required?: boolean\n  clearable?: boolean\n  name?: string\n  form?: string\n  id?: string\n  size?: 'sm' | 'md' | 'lg'\n  className?: string\n}",
