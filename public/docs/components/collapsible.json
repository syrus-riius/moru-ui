      "name": "children",
      "type": "ReactNode",
      "required": true
    },
    {
      "owner": "CollapsibleProps",
      "name": "open",
      "type": "boolean",
      "required": false
    },
    {
      "owner": "CollapsibleProps",
      "name": "defaultOpen",
      "type": "boolean",
      "required": false
    },
    {
      "owner": "CollapsibleProps",
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "required": false
    },
    {
      "owner": "CollapsibleProps",
      "name": "disabled",
      "type": "boolean",
      "required": false
    },
    {
      "owner": "CollapsibleProps",
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "required": false,
      "defaultValue": "'md'"
    },
    {
      "owner": "CollapsibleProps",
      "name": "className",
