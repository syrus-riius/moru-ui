{
  "schemaVersion": 1,
  "id": "calendar",
  "title": "Calendar",
  "description": "기본·미니멀·일정·활동 달력",
  "example": "import { useState } from 'react'\nimport { Calendar } from 'moru-ui'\n\nexport function PlanningCalendar() {\n  const [date, setDate] = useState<Date | null>(null)\n  return (\n    <Calendar\n      value={date}\n      onValueChange={setDate}\n      variant=\"minimal\"\n      dayShape=\"circle\"\n      aria-label=\"Planning date\"\n    />\n  )\n}",
  "installCommand": "npm install moru-ui",
  "sourceUrl": "https://github.com/syrus-riius/moru-ui/blob/main/src/components/ui/calendar.tsx",
  "api": "interface CalendarDayData {\n  label: string\n  tone?: 'neutral' | 'accent' | 'success' | 'warning' | 'danger' | 'info'\n  icon?: ReactNode\n  count?: number\n  completed?: boolean\n}\n\ninterface CalendarCommonProps {\n  minDate?: Date\n  maxDate?: Date\n  disabled?: boolean\n  locale?: string\n  className?: string\n  variant?: 'default' | 'minimal' | 'schedule' | 'activity'\n  size?: 'sm' | 'md' | 'lg'\n  dayShape?: 'rounded' | 'square' | 'circle'\n  weekStartsOn?: 0 | 1\n  showOutsideDays?: boolean\n  fixedWeeks?: boolean\n  /** Local date keys (YYYY-MM-DD), independent of the displayed locale. */\n  dayData?: Record<string, CalendarDayData>\n  'aria-label'?: string\n  'aria-describedby'?: string\n}\n\ninterface CalendarSingleProps extends CalendarCommonProps {\n  mode?: 'single'\n  value?: Date | null\n  defaultValue?: Date | null\n  onValueChange?: (value: Date) => void\n}\n\ninterface CalendarRangeProps extends CalendarCommonProps {\n  mode: 'range'\n  value?: CalendarRange\n  defaultValue?: CalendarRange\n  onValueChange?: (value: CalendarRange) => void\n}\n\ntype CalendarProps = CalendarSingleProps | CalendarRangeProps\n\nexport type { CalendarRange } from './calendar-utils'\n\nfunction Calendar(props: CalendarProps);",
  "props": [
    {
      "owner": "CalendarDayData",
      "name": "label",
      "type": "string",
      "required": true
    },
    {
      "owner": "CalendarDayData",
