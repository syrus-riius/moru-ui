      "type": "string",
      "required": false
    },
    {
      "owner": "CalendarSingleProps",
      "name": "mode",
      "type": "'single'",
      "required": false
    },
    {
      "owner": "CalendarSingleProps",
      "name": "value",
      "type": "Date | null",
      "required": false
    },
    {
      "owner": "CalendarSingleProps",
