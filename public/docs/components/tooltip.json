{
  "schemaVersion": 1,
  "id": "tooltip",
  "title": "Tooltip",
  "description": "짧은 보충 설명",
  "example": "import { Button } from 'moru-ui'\nimport { Tooltip } from 'moru-ui'\n\nexport function ExportHelp() {\n  return (\n    <Tooltip\n      trigger={\n        <Button type=\"button\" variant=\"secondary\">\n          Export options\n        </Button>\n      }\n    >\n      Choose a file format before downloading your report.\n    </Tooltip>\n  )\n}",
  "installCommand": "npm install moru-ui",
  "sourceUrl": "https://github.com/syrus-riius/moru-ui/blob/main/src/components/ui/tooltip.tsx",
  "api": "interface TooltipProviderProps {\n  children: ReactNode\n  delay?: number\n  closeDelay?: number\n  timeout?: number\n}\n\ninterface TooltipProps {\n  trigger: ReactElement\n  children: ReactNode\n  side?: ComponentPropsWithoutRef<typeof BaseTooltip.Positioner>['side']\n  align?: ComponentPropsWithoutRef<typeof BaseTooltip.Positioner>['align']\n  className?: string\n  delay?: number\n}\n\nfunction TooltipProvider({\n  children,\n  delay = 400,\n  closeDelay = 100,\n  timeout = 400,\n}: TooltipProviderProps);\nfunction Tooltip({\n  trigger,\n  children,\n  side = 'top',\n  align = 'center',\n  className,\n  delay,\n}: TooltipProps);",
  "props": [
