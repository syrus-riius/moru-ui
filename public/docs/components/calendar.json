      "required": false
    },
    {
      "owner": "CalendarRangeProps",
      "name": "defaultValue",
      "type": "CalendarRange",
      "required": false
    },
    {
      "owner": "CalendarRangeProps",
      "name": "onValueChange",
      "type": "(value: CalendarRange) => void",
      "required": false
    }
  ],
