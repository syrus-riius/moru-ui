{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "noEmitOnError": true,
    "rootDir": "./.qa/moru-package-src",
    "outDir": "./packages/moru-react/dist"
  },
  "files": [
    ".qa/moru-package-src/index.ts",
    ".qa/moru-package-src/blocks.ts",
    ".qa/moru-package-src/dashboard.ts",
    ".qa/moru-package-src/chart.tsx",
    ".qa/moru-package-src/data-table.tsx",
    ".qa/moru-package-src/carousel.tsx",
    ".qa/moru-package-src/resizable.tsx"
  ]
}
