    },
    {
      "owner": "TooltipProviderProps",
      "name": "closeDelay",
      "type": "number",
      "required": false,
      "defaultValue": "100"
    },
    {
      "owner": "TooltipProviderProps",
      "name": "timeout",
      "type": "number",
      "required": false,
      "defaultValue": "400"
    },
    {
      "owner": "TooltipProps",
      "name": "trigger",
